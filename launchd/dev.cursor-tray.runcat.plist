<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.cursor-tray.runcat</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/.local/bin/cursor-tray</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOU/Library/Logs/cursor-tray.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/cursor-tray.err.log</string>
</dict>
</plist>
